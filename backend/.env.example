# ---------------------------------------------------------------------------
# PagalPagal backend configuration
# Copy to .env and edit. On your VPS, leave DATABASE_URL pointing at the local
# PostgreSQL you install with scripts/setup-postgres.sh. Media is always stored
# on this server's disk. Copy .env.example -> .env on the server.
# ---------------------------------------------------------------------------

#--- Server -----------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Public HTTPS origin of the API (used for local media URLs and the WS URL).
PUBLIC_BASE_URL=https://api.yourdomain.com
# Frontend origin used to build email verification / reset links.
APP_URL=https://yourdomain.com
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=https://yourdomain.com,http://localhost:8081
LOG_LEVEL=info

#--- PostgreSQL (installed on this server) ----------------------------------
# Created by scripts/setup-postgres.sh. Use a strong password.
DATABASE_URL=postgresql://pagalpagal:change-me@127.0.0.1:5432/pagalpagal
# Only enable if your PostgreSQL/proxy actually requires TLS.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

#--- JWT / sessions ----------------------------------------------------------
# Use a random 32+ character secret in production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=30

#--- Email / authentication (Brevo) ----------------------------------------
# console | brevo. Use brevo in production.
EMAIL_PROVIDER=brevo
# Dev only: returns devToken/devLink in API responses instead of sending mail.
EMAIL_DEV_MODE=false
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=PagalPagal
# Brevo template IDs: verification/login template uses params.name + params.OTP;
# reset template uses params.name + params.reset_link.
BREVO_TEMPLATE_VERIFY_ID=
BREVO_TEMPLATE_RESET_ID=
EMAIL_OTP_TTL_MINUTES=10
EMAIL_LOGIN_OTP_TTL_MINUTES=5
EMAIL_RESET_TTL_MINUTES=30
EMAIL_RESEND_SECONDS=60
EMAIL_MAX_TOKENS_PER_HOUR=5
EMAIL_MAX_OTP_ATTEMPTS=5

#--- Media storage (local disk only) ----------------------------------------
LOCAL_STORAGE_DIR=data/uploads
LOCAL_STORAGE_SECRET=
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=3600

#--- Media limits / video lifecycle -----------------------------------------
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=60
VIDEO_MAX_DURATION_SECONDS=60
VIDEO_RETENTION_HOURS=8
PENDING_UPLOAD_TTL_MINUTES=60
GALLERY_MAX_PHOTOS=6
MEDIA_CLEANUP_INTERVAL_MS=300000
FFPROBE_PATH=ffprobe
REQUIRE_VIDEO_PROBE=true

#--- Razorpay / Plus ---------------------------------------------------------
# Leave keys empty for mock mode (development only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_MOCK=false
RAZORPAY_PLAN_ID_1M=
RAZORPAY_PLAN_ID_6M=
RAZORPAY_PLAN_ID_12M=
